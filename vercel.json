{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "version":2,
 "framework":null,
 "buildCommand":"npm run build",
 "outputDirectory":"public",
 "functions":{"api/handler.js":{"maxDuration":60}},
 "rewrites":[
  {"source":"/api/:path*","destination":"/api/handler?route=api/:path*"},
  {"source":"/media/:path*","destination":"/api/handler?route=media/:path*"},
  {"source":"/invite/:id","destination":"/guest.html"}
 ]
}
