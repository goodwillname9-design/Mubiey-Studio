# Supabase Connect > Transaction pooler URI; URL-encode special password characters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Download prod-ca-2021.crt from Supabase Database Settings > SSL Configuration.
SUPABASE_DB_CA_CERT=.certs/prod-ca-2021.crt
# For Vercel, set SUPABASE_DB_CA to the complete PEM contents of that official certificate.
# Backend only. Never use a NEXT_PUBLIC_ or VITE_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Initializes username admin on its first sign-in. Minimum 16 characters.
MUBIEY_ADMIN_PASSWORD=CHOOSE_A_UNIQUE_LONG_PASSWORD
