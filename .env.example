# Supabase Connect > Transaction pooler URI; URL-encode special password characters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Backend only. Never use a NEXT_PUBLIC_ or VITE_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Initializes username admin on its first sign-in. Minimum 16 characters.
MUBIEY_ADMIN_PASSWORD=CHOOSE_A_UNIQUE_LONG_PASSWORD
